# Gemini API (Recommended: Restrict in Google Cloud Console / AI Studio by HTTP Referrers:
# Allowed referrers: https://<your-project>.web.app/* and http://localhost:*)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Backend Proxy Endpoint for Zero-Client-Key architecture:
# If provided, all composition analyses are forwarded to this URL instead of calling Google directly.
# VITE_GEMINI_PROXY_URL=https://your-cloud-function-or-api.com/analyze

# Firebase Web App Config (get from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
