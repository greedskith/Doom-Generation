rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredPhotoFields() {
      return request.resource.data.keys().hasAll(['url', 'title', 'author', 'userId', 'likes', 'likedBy', 'timestamp']) &&
             request.resource.data.keys().hasOnly(['url', 'title', 'author', 'userId', 'likes', 'likedBy', 'timestamp', 'width', 'height']);
    }

    function isValidPhotoCreate() {
      return isAuthenticated() &&
             hasRequiredPhotoFields() &&
             request.resource.data.userId == request.auth.uid &&
             request.resource.data.url is string &&
             (request.resource.data.url.matches("^https://.*") || request.resource.data.url.matches("^http://.*")) &&
             request.resource.data.url.size() <= 1500 &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 100 &&
             request.resource.data.author is string &&
             request.resource.data.author.size() <= 100 &&
             request.resource.data.likes == 0 &&
             request.resource.data.likedBy is list &&
             request.resource.data.likedBy.size() == 0 &&
             (!('width' in request.resource.data) || (request.resource.data.width is int && request.resource.data.width > 0)) &&
             (!('height' in request.resource.data) || (request.resource.data.height is int && request.resource.data.height > 0));
    }


    function isValidTitleUpdate() {
      return isAuthenticated() &&
             (resource.data.userId == request.auth.uid || isAdmin()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 100;
    }

    function isValidAnalysisUpdate() {
      return isAuthenticated() &&
             (isOwner(resource.data.userId) || isAdmin() || !('analysis' in resource.data)) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analysis']) &&
             request.resource.data.analysis is map &&
             request.resource.data.analysis.rule is string &&
             request.resource.data.analysis.focalPoints is list &&
             (!('lines' in request.resource.data.analysis) || request.resource.data.analysis.lines is list);
    }

    function isValidLikeToggle() {
      return isAuthenticated() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) &&
             request.resource.data.likes is int &&
             request.resource.data.likedBy is list &&
             (
               // Like: Increment by 1 and user ID added
               (request.resource.data.likes == resource.data.likes + 1 &&
                request.resource.data.likedBy.hasAll(resource.data.likedBy) &&
                request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                !resource.data.likedBy.hasAny([request.auth.uid]) &&
                request.resource.data.likedBy.hasAll([request.auth.uid])) ||
               // Unlike: Decrement by 1 and user ID removed
               (request.resource.data.likes == resource.data.likes - 1 &&
                resource.data.likedBy.hasAll(request.resource.data.likedBy) &&
                request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                resource.data.likedBy.hasAny([request.auth.uid]) &&
                !request.resource.data.likedBy.hasAny([request.auth.uid]))
             );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isValidPhotoCreate() && isAdmin();
      allow update: if isValidTitleUpdate() || isValidLikeToggle() || isValidAnalysisUpdate();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /admins/{email} {
      allow get: if isAuthenticated() && request.auth.token.email == email;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'lastLogin']) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.lastLogin is string;
      allow delete: if false;
    }

    match /user_stats/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['uploadsThisWeek', 'weekStartDate']) &&
        request.resource.data.uploadsThisWeek is int &&
        request.resource.data.uploadsThisWeek >= 1 &&
        request.resource.data.uploadsThisWeek <= 5 &&
        request.resource.data.weekStartDate is timestamp;
      allow delete: if false;
    }
  }
}
