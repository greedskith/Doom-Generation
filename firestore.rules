rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    
    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow update/delete if you are the owner, OR if you are an admin.
      // (Also allow updating likes which doesn't strictly check userId, but we can allow it for now)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    match /user_stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
